{
  "name": "campaign-verifier",
  "version": "0.1.0",
  "private": false,
  "description": "Independent, client-only verifier for publicly published campaign draws.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check:docs": "node tools/check-docs.mjs",
    "verify:rfc3161": "node --experimental-strip-types tools/verify-rfc3161.ts"
  },
  "dependencies": {
    "asn1js": "3.0.10",
    "drand-client": "1.4.2",
    "pkijs": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
